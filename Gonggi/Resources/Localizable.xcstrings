    "Not enough points inside the box.\nCapture again so the box surrounds the object. The original stays on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough points inside the box.\nCapture again so the box surrounds the object. The original stays on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択範囲内の点が足りません。\nボックスが物体を囲むようにもう一度撮影してください。元のデータはデバイスに保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 범위 안에 학습에 필요한 점이 부족해요.\n상자가 물체를 감싸도록 다시 촬영해 주세요. 원본은 기기에 보관돼 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选框内可用的点不足。\n请重新拍摄，让选框包住物体。原始数据仍保存在此设备上。"
          }
        }
      }
    },
    "Not enough points inside the box. Capture again with the box fitted to the object": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough points inside the box. Capture again with the box fitted to the object"
