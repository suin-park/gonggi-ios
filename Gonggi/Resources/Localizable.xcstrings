        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片无效"
          }
        }
      }
    },
    "The photo limit was reached, so no more photos were saved. Saved data is kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo limit was reached, so no more photos were saved. Saved data is kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の保存上限に達したため、新しい写真は保存されませんでした。保存済みのデータは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 저장 한도에 도달해 더 이상 새 사진이 저장되지 않았어요. 이미 저장된 데이터는 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到照片保存上限，未再保存新照片。已保存的数据会保留。"
          }
        }
      }
    },
    "The photo limit was reached. You can continue with what's already saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo limit was reached. You can continue with what's already saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の保存上限に達しました。保存済みのデータで続けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진 저장 한도에 도달했어요. 이미 저장된 데이터로 이어갈 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到照片保存上限。可以用已保存的数据继续。"
          }
        }
      }
    },
    "The placement info isn't valid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The placement info isn't valid"
          }
        },
