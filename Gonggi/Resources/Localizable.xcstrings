    "%1$@, %2$@ photos. Captured on this device before it was linked to an account.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@ photos. Captured on this device before it was linked to an account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、写真%2$@枚。アカウントに紐付く前にこのデバイスで撮影したものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, 사진 %2$@장. 이 기기에서 촬영했지만 계정 정보가 기록되기 전의 촬영이에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$@ 张照片。在此设备上拍摄，但当时尚未关联账号。"
          }
        }
      }
    },
