        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@側は遠くからしか撮影されていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 쪽은 멀리서만 담겼어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@侧只从远处拍到了"
          }
        }
      }
    },
    "The 3D Object isn't ready yet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 3D Object isn't ready yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3Dオブジェクトの準備がまだできていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 3D 어셋이 준비되지 않았어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 物体尚未就绪"
          }
        }
      }
    },
    "The 3D creation server isn't ready yet.\nThe original capture stays on this device. Try again from Library in a moment.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The 3D creation server isn't ready yet.\nThe original capture stays on this device. Try again from Library in a moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3D作成サーバーの準備がまだできていません。\n元の撮影データはデバイスに保存されています。しばらくしてからライブラリで再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 공간 생성 서버가 아직 준비되지 않았어요.\n촬영 원본은 기기에 보관돼 있어요. 잠시 후 보관함에서 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3D 生成服务器尚未就绪。\n原始拍摄数据保存在此设备上。请稍后在资料库中重试。"
          }
        }
      }
    },
    "The analysis server had an error.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The analysis server had an error."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析サーバーでエラーが発生しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분석 서버에서 오류가 났어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析服务器出错。"
          }
        }
      }
    },
    "The box just needs to surround the object. Move and resize it with your fingers": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The box just needs to surround the object. Move and resize it with your fingers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボックスが物体を囲めば大丈夫です。指で移動してサイズを合わせてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상자가 물체를 감싸면 돼요. 손가락으로 옮기고 크기를 맞춰 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选框包住物体即可。用手指移动并调整大小"
          }
        }
      }
    },
    "The box only needs to roughly surround the object. It doesn't have to be exact.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The box only needs to roughly surround the object. It doesn't have to be exact."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボックスが物体をおおよそ囲めば大丈夫です。正確に合わせなくても構いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상자가 물체를 대략 감싸면 돼요. 정확히 맞추지 않아도 괜찮아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选框大致包住物体即可，不必完全精确。"
          }
        }
      }
    },
    "The capture is too large to upload.\nPlease capture a little shorter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The capture is too large to upload.\nPlease capture a little shorter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撮影データが大きすぎてアップロードできません。\nもう少し短く撮影してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촬영 데이터가 너무 커서 올릴 수 없어요.\n조금 더 짧게 다시 촬영해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍摄数据太大，无法上传。\n请缩短拍摄后重试。"
          }
        }
      }
    },
    "The code is incorrect or has expired.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is incorrect or has expired."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが正しくないか、期限が切れています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 올바르지 않거나 만료됐어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证码不正确或已过期。"
          }
        }
      }
    },
    "The device may be low on memory. Close other apps and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device may be low on memory. Close other apps and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのメモリが不足している可能性があります。他のアプリを閉じてもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 메모리가 부족할 수 있어요. 다른 앱을 닫고 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备内存可能不足。请关闭其他应用后重试。"
          }
        }
      }
    },
    "The device may have run low on memory. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device may have run low on memory. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのメモリが不足した可能性があります。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 메모리가 부족했을 수 있어요. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备内存可能已不足，请重试。"
          }
        }
      }
    },
    "The download stopped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The download stopped"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードが止まりました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드가 멈췄어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载已停止"
          }
        }
      }
    },
    "The email or password is incorrect.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The email or password is incorrect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアドレスまたはパスワードが正しくありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일 또는 비밀번호가 올바르지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮箱或密码不正确。"
          }
        }
      }
    },
    "The file is too large": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too large"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが大きすぎます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 너무 커요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件过大"
          }
        }
      }
    },
    "The file is too large (max 500 MB)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too large (max 500 MB)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが大きすぎます（最大500MB）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 너무 커요 (최대 500MB)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件过大（最大 500 MB）"
          }
        }
      }
    },
    "The file is too large. Upload 20 MB or less.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is too large. Upload 20 MB or less."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが大きすぎます。20MB以下でアップロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 너무 커요. 20MB 이하로 올려 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件过大，请上传 20 MB 以内的文件。"
          }
        }
      }
    },
    "The first save failed. Line up the same view again to start.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first save failed. Line up the same view again to start."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の保存に失敗しました。同じ場面にもう一度合わせて始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 저장에 실패했습니다. 같은 장면을 다시 맞춰 연결을 시작해 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次保存失败。请重新对准同一画面开始。"
          }
        }
      }
    },
    "The floor is captured well": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The floor is captured well"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "床もしっかり記録されました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바닥도 잘 기록됐어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地面也已拍好"
          }
        }
      }
    },
    "The floor isn't recognized well. Slowly point at an area with patterns or edges": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The floor isn't recognized well. Slowly point at an area with patterns or edges"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "床がうまく認識されません。模様や角が見える場所をゆっくり映してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바닥이 잘 인식되지 않아요. 무늬나 모서리가 보이는 곳을 천천히 비춰 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地面识别不佳。请慢慢对准有花纹或边角的地方"
          }
        }
      }
    },
    "The job expired while waiting.\nRetry the same capture from Library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The job expired while waiting.\nRetry the same capture from Library."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待ち時間が過ぎて処理が期限切れになりました。\nライブラリから同じ撮影で再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성 대기 시간이 지나 작업이 만료됐어요.\n보관함에서 같은 촬영으로 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待超时，任务已过期。\n请在资料库中用同一次拍摄重试。"
          }
        }
      }
    },
    "The job took too long and was stopped. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The job took too long and was stopped. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理に時間がかかりすぎたため中断されました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 너무 오래 걸려 중단되었습니다. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务耗时过长已中止，请重试。"
          }
        }
      }
    },
    "The last view is too weak to finish. Turn little by little so it connects to what you just saw": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last view is too weak to finish. Turn little by little so it connects to what you just saw"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前の場面が弱いため完了できません。いま見た場所とつながるように少しずつ回して撮影してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝난 직전 장면이 약해 완료할 수 없어요. 방금 본 곳과 이어지게 조금씩 돌려 촬영해 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后的画面衔接太弱，无法完成。请一点点转动，与刚才看到的位置衔接起来"
          }
        }
      }
    },
    "The linked space itself isn't deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The linked space itself isn't deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "つながったスペース自体は削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 공간 자체는 삭제되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接的空间本身不会被删除。"
          }
        }
      }
    },
    "The network may be unstable. Please try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network may be unstable. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークが不安定な可能性があります。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크가 불안정할 수 있어요. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络可能不稳定，请重试。"
          }
        }
      }
    },
    "The object left the frame": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The object left the frame"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物体が画面の外に出ました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물체가 화면 밖으로 나갔어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "物体移出了画面"
          }
        }
      }
    },
    "The original capture is still on this device. Upload it again to continue.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original capture is still on this device. Upload it again to continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のデータはこのデバイスに残っています。もう一度アップロードすると続きから進めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본은 이 기기에 남아 있어요. 다시 업로드하면 같은 촬영으로 이어서 진행해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始拍摄仍保存在此设备上。重新上传即可继续。"
          }
        }
      }
    },
    "The original capture isn't on this device anymore.\nIt can't be retried. Please capture again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original capture isn't on this device anymore.\nIt can't be retried. Please capture again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元の撮影データがこのデバイスにありません。\n同じ撮影で再試行できません。もう一度撮影してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 원본 촬영 패키지를 찾을 수 없어요.\n같은 촬영으로 다시 시도할 수 없습니다. 새로 촬영해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上已找不到原始拍摄数据。\n无法用同一次拍摄重试，请重新拍摄。"
          }
        }
      }
    },
    "The original capture stays on this device even if this fails.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original capture stays on this device even if this fails."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗しても元の撮影データはデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 촬영 데이터는 실패 후에도 기기에 남아 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使失败，原始拍摄数据也会保留在此设备上。"
          }
        }
      }
    },
    "The original space stays as is, and a new version without furniture is made.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original space stays as is, and a new version without furniture is made."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のスペースはそのまま残り、家具を取り除いた新しいバージョンが作られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 공간은 그대로 유지되고, 가구를 비운 새 버전이 만들어집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原空间保持不变，会生成一个移除家具的新版本。"
          }
        }
      }
    },
    "The panorama file is missing or damaged.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The panorama file is missing or damaged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パノラマファイルがないか、破損している可能性があります。"
          }
