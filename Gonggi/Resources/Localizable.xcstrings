        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 흔들리지 않게 들고 천천히 둘러봐 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请拿稳手机，慢慢环顾四周"
          }
        }
      }
    },
