    "Keep the phone upright and turn slowly to the right.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the phone upright and turn slowly to the right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを立てたまま、ゆっくり右に回ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 세운 채 천천히 오른쪽으로 돌아주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持手机竖直，慢慢向右转。"
          }
        }
      }
    },
    "Keep turning a little more slowly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep turning a little more slowly"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向きをもう少しゆっくり変えてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방향을 조금 더 천천히 이어가 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请再放慢转向"
          }
        }
      }
    },
    "Keep what you see on screen and slowly turn while moving where you can walk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep what you see on screen and slowly turn while moving where you can walk"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま見えている場所を画面に入れたまま、歩ける方へ移動しながらゆっくり向きを変えてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 보이는 곳을 화면에 둔 채, 걸을 수 있는 쪽으로 옮기며 천천히 방향을 바꿔 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让当前画面保持在屏幕内，往能走的方向移动并慢慢转向"
          }
        }
      }
    },
    "Keep what you see on screen and take two or three steps where you can walk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep what you see on screen and take two or three steps where you can walk"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま見えている場所を画面に入れたまま、歩ける方へ二、三歩移動してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 보이는 곳을 화면에 둔 채 걸을 수 있는 쪽으로 두세 걸음 옮겨 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让当前画面保持在屏幕内，往能走的方向走两三步"
          }
        }
      }
    },
    "Keeping the guide line makes it join more naturally": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping the guide line makes it join more naturally"
