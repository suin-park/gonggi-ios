        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파노라마 파일이 없거나 손상되었을 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全景文件可能缺失或已损坏。"
          }
        }
      }
    },
    "The panorama file is missing. Please capture again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The panorama file is missing. Please capture again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パノラマファイルがありません。もう一度撮影してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
