        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択範囲内の点が足りません。ボックスを物体に合わせてもう一度撮影してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 범위 안에 학습에 필요한 점이 부족해요, 상자를 물체에 맞게 다시 촬영해 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
