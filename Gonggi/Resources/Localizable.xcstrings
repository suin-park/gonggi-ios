        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宽 %1$@ 毫米，深 %2$@ 毫米，高 %3$@ 毫米，尺寸调整锁定"
          }
        }
      }
    },
    "You can also start the 3D capture with the standard guide.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also start the 3D capture with the standard guide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本の案内でも立体記録を始められます。"
