          }
        }
      }
    },
    "Raise the phone a little and move slowly where you can walk. Don't point only at the ceiling": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise the phone a little and move slowly where you can walk. Don't point only at the ceiling"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホを少し上げて、歩ける方へゆっくり移動してください。天井だけを映さないでください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 조금 들고 걸을 수 있는 쪽으로 천천히 옮겨 주세요. 천장만 비추지는 말아 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微抬起手机，往能走的方向慢慢移动。不要只对着天花板"
          }
        }
      }
    },
    "Raise the phone a little so the wall-ceiling line or lights are visible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raise the phone a little so the wall-ceiling line or lights are visible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁と天井が接する線や照明が見えるように、スマホを少し上げてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽과 천장이 만나는 선이나 조명이 보이게 휴대폰을 조금 들어 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微抬起手机，让墙与天花板交界线或灯具入镜"
          }
