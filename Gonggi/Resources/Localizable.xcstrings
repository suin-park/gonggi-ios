    "Only objects with AR and placement ready can be used": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only objects with AR and placement ready can be used"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AR・配置の準備が完了したオブジェクトのみ使えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AR/배치 준비가 완료된 어셋만 사용할 수 있어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
