    "Pause and point at one spot to start saving again. Turn slowly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause and point at one spot to start saving again. Turn slowly"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し止まって一か所を映すと、また保存されます。向きはゆっくり変えてください"
          }
