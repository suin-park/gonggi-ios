    "Keep the app open until the upload finishes. The original capture stays on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the app open until the upload finishes. The original capture stays on this device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードが終わるまでアプリを開いたままにしてください。元の撮影データはデバイスに保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드가 끝날 때까지 앱을 열어 두세요. 촬영 원본은 기기에 보관돼 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
