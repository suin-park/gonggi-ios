    "Only objects that stay still can be captured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only objects that stay still can be captured"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動かない物体だけ作成できます"
          }
        },
        "ko": {
