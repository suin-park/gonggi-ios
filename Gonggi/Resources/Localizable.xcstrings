    "Payment and accounting records that must be kept by law are stored apart from account data under the retention policy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment and accounting records that must be kept by law are stored apart from account data under the retention policy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "法律で保管が必要な決済・会計記録は、アカウントのデータとは別に保管ポリシーに従って保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "법적으로 보관해야 하는 결제와 회계 기록은 계정 데이터와 분리되어 보관 정책에 따라 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依法需保留的付款与会计记录会与账号数据分开，按保留政策保存。"
          }
        }
      }
    },
