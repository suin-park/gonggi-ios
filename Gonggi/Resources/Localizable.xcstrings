    "Upload failed.\nThe connection may have dropped. Try again on Wi‑Fi.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload failed.\nThe connection may have dropped. Try again on Wi‑Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードに失敗しました。\n接続が切れた可能性があります。Wi‑Fiでもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드에 실패했어요.\n네트워크 연결이 끊겼을 수 있어요. Wi‑Fi에서 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传失败。\n网络连接可能已中断。请在 Wi‑Fi 下重试。"
          }
        }
      }
    },
    "Upload on Wi‑Fi, or allow cellular uploads in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload on Wi‑Fi, or allow cellular uploads in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fiでアップロードするか、設定でモバイル通信でのアップロードを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi에서 업로드하거나, 설정에서 셀룰러 업로드를 허용해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 Wi‑Fi 下上传，或在设置中允许蜂窝数据上传。"
