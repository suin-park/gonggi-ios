          }
        }
      }
    },
    "For long objects, set width, height and depth separately. Make the height a little above the top of the object": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For long objects, set width, height and depth separately. Make the height a little above the top of the object"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "細長い物体は幅・高さ・奥行きを別々に合わせてください。高さは物体の一番上より少し高めにしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길쭉한 물체는 가로/높이/깊이를 따로 맞추세요. 높이는 물체 맨 위보다 조금 높게 잡아 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "细长物体请分别调整宽、高、深。高度请比物体顶部稍高一些"
          }
        }
      }
    },
