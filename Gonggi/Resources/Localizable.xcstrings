    "It will be deleted from both 3D Locker and WHIK, and removed from any space it's placed in. This can't be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will be deleted from both 3D Locker and WHIK, and removed from any space it's placed in. This can't be undone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3D LockerとWHIKの両方から削除され、スペースに配置されている場合は配置も削除されます。元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3D Locker와 WHIK 앱에서 함께 삭제되며, 공간에 배치된 경우 배치도 제거돼요. 되돌릴 수 없어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将同时从 3D Locker 和 WHIK 中删除，若已放置在空间中也会一并移除。此操作无法撤销。"
          }
        }
      }
    },
    "It's fine if the floor and surroundings are in the shot. Only the object is kept in the result": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's fine if the floor and surroundings are in the shot. Only the object is kept in the result"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "床や周りが一緒に写っても大丈夫です。結果には物体だけが残ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바닥과 주변이 함께 찍혀도 괜찮아요. 결과에서는 물체만 남겨요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地面和周围一起拍进去也没关系，结果中只保留物体"
          }
        }
      }
    },
