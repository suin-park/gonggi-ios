    "Take a few steps where you can walk and turn slowly so the photos keep connecting": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a few steps where you can walk and turn slowly so the photos keep connecting"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歩ける方へ数歩移動しながらゆっくり向きを変えると、写真が途切れずにつながります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걸을 수 있는 쪽으로 몇 걸음 옮기며 천천히 방향을 바꾸면 사진이 끊기지 않고 이어져요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "往能走的方向走几步并慢慢转向，照片就能连续衔接"
          }
        }
      }
    },
    "Take a step back": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a step back"
          }
        },
        "ja": {
