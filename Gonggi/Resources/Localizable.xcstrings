        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 멈춰 한 곳을 비추면 다시 저장돼요. 방향은 천천히 바꿔 주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
