    "The saved photos lost their connection. Move slowly until the last connected view appears again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved photos lost their connection. Move slowly until the last connected view appears again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した写真のつながりが途切れました。最後につながった画面がもう一度映るようにゆっくり動いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 사진 사이 연결이 끊겼습니다. 마지막 연결 화면이 다시 보이도록 천천히 움직여 연결을 보강해주세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
