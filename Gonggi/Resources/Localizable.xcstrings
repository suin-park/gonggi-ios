          }
        }
      }
    },
    "The position anchor moved a lot. The box was kept at the capture's starting range": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The position anchor moved a lot. The box was kept at the capture's starting range"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置アンカーが大きく揺れました。ボックスは撮影開始時の範囲のままにしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 앵커가 크게 흔들렸어요. 상자는 촬영 시작 범위로 유지했어요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置锚点大幅晃动。选框已保持在拍摄开始时的范围"
          }
        }
      }
    },
    "The position reference changed. Photos so far are kept; don't continue this capture": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The position reference changed. Photos so far are kept; don't continue this capture"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置の座標系が変わりました。これまでの写真は保存しました。同じ撮影の続きは撮らないでください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 좌표계가 바뀌었어요. 지금까지 찍은 사진은 보관하고, 같은 촬영에 이어 찍지 마세요"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置坐标系已改变。目前拍的照片已保存，请不要继续这次拍摄"
          }
        }
      }
    },
    "The position reference changed. Please start a new capture": {
